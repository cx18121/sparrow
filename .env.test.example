# E2E test environment — copy to .env.test.local and fill in your local Supabase values.
# Get values by running: supabase status
# These only work against your local Docker instance, not production.

E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=sb_publishable_...
E2E_SUPABASE_SERVICE_KEY=sb_secret_...
E2E_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
