{
  "name": "sparrow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vercel dev",
    "dev:api:local": "tsx watch local-api.ts",
    "prebuild": "tsx scripts/check-build-env.ts && tsc -b",
    "build": "prisma generate && vite build",
    "check": "tsc -b",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reportOnFailure true",
    "test:e2e": "node scripts/gen-test-env.js && playwright test",
    "test:e2e:reset": "SUPABASE_RESET=1 node scripts/gen-test-env.js && SUPABASE_RESET=1 playwright test",
    "test:e2e:raw": "playwright test",
    "db:push:local": "node scripts/db-push.mjs local",
    "db:push:prod": "node scripts/db-push.mjs prod",
    "db:migrate:create": "node scripts/db-push.mjs migrate-create",
    "db:migrate:deploy": "node scripts/db-push.mjs migrate-deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.43.0",
    "@tiptap/extension-link": "^2.3.0",
    "@tiptap/extension-placeholder": "^2.3.0",
    "@tiptap/extension-underline": "^2.3.0",
    "@tiptap/react": "^2.3.0",
    "@tiptap/starter-kit": "^2.3.0",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.363.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@prisma/config": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.7.13",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.38",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.0"
  }
}
