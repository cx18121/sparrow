{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["server/lib/**/*.ts", "server/routes/**/*.ts", "server/router.ts", "api/**/*.ts"],
  "exclude": ["server/__tests__/**", "**/*.d.ts"]
}
