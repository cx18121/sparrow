
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google OAuth (via Supabase) ─────────────────────────────────────────────
# No key goes here — Google credentials are entered in Supabase Dashboard only.
# Setup steps:
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      - Application type: Web application
#      - Authorized redirect URI: https://your-project.supabase.co/auth/v1/callback
#   2. Supabase Dashboard → Authentication → Providers → Google
#      - Paste Client ID and Client Secret from step 1
#   3. Fill in VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY above → Google sign-in works.


DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Free scraped sources (on by default, set to "true" to disable) ──────────
# SKIP_THEHUB=false
# SKIP_STARTUPS_GALLERY=false
# SKIP_GREGSLIST=false

# ─── Paid API keys ────────────────────────────────────────────────────────────
# APOLLO_API_KEY=
