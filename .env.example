
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Encryption ───────────────────────────────────────────────────────────────
# Used to encrypt API keys (Claude, Google refresh tokens) at rest.
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=

# ─── Google OAuth / Gmail sending ────────────────────────────────────────────
# Use the same Google OAuth client for Google sign-in and Gmail sending.
# Setup steps:
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      - Application type: Web application
#      - Authorized redirect URIs:
#        - https://your-project.supabase.co/auth/v1/callback
#        - https://your-app-domain.com/api/google/callback
#        - http://localhost:5173/api/google/callback
#   2. Supabase Dashboard → Authentication → Providers → Google
#      - Paste Client ID and Client Secret from step 1
#   3. Also set these env vars so Coldflow can store a Gmail refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
# Backward-compatible alias also supported: GOOGLE_OAUTH_SECRET=
# Required in production. Set to the public app origin used for OAuth redirects.
# Example: APP_ORIGIN=https://your-app-domain.com
APP_ORIGIN=


DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Scraped sources (on by default, set to "true" to disable) ───────────────
# SKIP_THEHUB=false
# SKIP_GREGSLIST=false
# SKIP_HN_HIRING=false

# ─── AI / paid API keys ──────────────────────────────────────────────────────
# Host-managed Claude key. Powers email generation for every user
# (per-user BYO-key path is retired) and the LLM-based enrichment scripts
# (enrich-locations-llm, enrich-industries-llm).
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apollo.io key for free search + paid reveal flows. Required by the
# scrapers and the /api/apollo-search endpoint.
# APOLLO_API_KEY=
