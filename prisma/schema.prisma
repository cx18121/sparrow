generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Company {
  id            String    @id @default(cuid())
  name          String
  domain        String    @unique
  description   String?   @db.Text
  oneLiner      String?
  website       String?
  stage         String?
  industry      String?
  subIndustry   String?
  location      String?
  region        String?
  headcount     Int?
  isHiring      Boolean   @default(false)
  batch         String?
  source        String
  sourceId      String?
  tags          String[]  @default([])
  isVerified    Boolean   @default(true)
  qualityScore  Int?
  lastScrapedAt DateTime?
  // Cached research output from researchCompanyDossier (web search). Reused
  // across all users emailing this company until researchedAt > 30d old.
  // Per-user fit-angle picking happens on top via pickFitAngle (token-only).
  researchDossier Json?
  researchedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contacts      Contact[]
  userLeads     UserLead[]
  campaignSeen  CampaignSeenCompany[]
  discoverySeen DiscoverySeenCompany[]

  @@index([stage])
  @@index([industry])
  @@index([region])
  @@index([isHiring])
  @@index([source])
  @@index([headcount])
  @@index([isVerified])
  @@index([tags], type: Gin)
  @@schema("public")
}

model Contact {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String?
  email          String?   @unique
  title          String?
  role           String?
  linkedinUrl    String?
  source         String
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userLeads UserLead[]
  emails    Email[]

  @@index([companyId])
  @@index([role])
  @@index([lastVerifiedAt])
  @@schema("public")
}

model UserLead {
  id             String     @id @default(cuid())
  userId         String
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  contactId      String?
  contact        Contact?   @relation(fields: [contactId], references: [id])
  apolloPersonId String?
  status         LeadStatus @default(SAVED)
  notes          String?    @db.Text
  addedAt        DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  emails        Email[]
  campaignLeads CampaignLead[]

  @@unique([userId, companyId, contactId])
  @@index([userId])
  @@index([status])
  @@index([companyId])
  @@index([contactId])
  @@schema("public")
}

enum LeadStatus {
  SAVED
  EMAILED
  RESPONDED
  NO_RESPONSE
  DECLINED
  // Set when an outbound email to this lead bounces (the Gmail webhook
  // classifies the inbound DSN as ReplyClassification.BOUNCE). Marks the
  // address as undeliverable so it isn't treated as a live "awaiting
  // reply" lead or re-emailed.
  BOUNCED

  @@schema("public")
}

model CustomContact {
  id          String     @id @default(cuid())
  userId      String
  name        String?
  email       String?
  title       String?
  companyName String?
  status      LeadStatus @default(SAVED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  emails    Email[]
  campaigns CampaignCustomContact[]

  @@index([userId])
  @@schema("public")
}

model Email {
  id              String         @id @default(cuid())
  userLeadId      String?
  userLead        UserLead?      @relation(fields: [userLeadId], references: [id])
  contactId       String?
  contact         Contact?       @relation(fields: [contactId], references: [id])
  customContactId String?
  customContact   CustomContact? @relation(fields: [customContactId], references: [id])
  subject         String?
  body            String?        @db.Text
  status          String         @default("draft")
  attachmentIds   Json           @default("[]")
  // AI generation metadata (nullable — populated only by the draft-generation
  // path; rows pre-migration and rows written by other paths stay null).
  // Per ADR-0005, persistence columns are role-specific so the schema and
  // queries stay readable. featureLine/fitAngle hold engineering+product
  // role personalization; gtm* fields hold GTM role personalization.
  // Only one role's fields are populated per row, selected by the
  // generating campaign's targetRole.
  featureLine        String?
  fitAngle           String?
  gtmTriggerLine     String?
  gtmProofOfMotion   String?
  opsInflectionLine  String?
  opsSystemBuilt     String?
  generationKind     String?
  sentAt          DateTime?
  // Reply detection fields — populated at send time and on inbound webhook.
  gmailMessageId      String?
  gmailThreadId       String?
  openedAt            DateTime?
  openCount           Int                   @default(0)
  repliedAt           DateTime?
  replyMessageId      String?
  replyFrom           String?
  replyClassification ReplyClassification?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userLeadId])
  @@index([contactId])
  @@index([customContactId])
  @@index([status, createdAt])
  @@index([userLeadId, status, createdAt])
  @@index([customContactId, status, createdAt])
  @@index([gmailThreadId])
  @@schema("public")
}

enum ReplyClassification {
  REPLY
  AUTO_REPLY
  BOUNCE
  OTHER

  @@schema("public")
}

model UserGmailWatch {
  userId         String   @id
  email          String   @unique
  watchExpiresAt DateTime
  historyId      String
  pubsubTopic    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("public")
}

model IdempotencyKey {
  userId      String
  key         String
  requestHash String
  status      String   @default("processing")
  response    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@id([userId, key])
  @@index([expiresAt])
  @@schema("public")
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String
  body      String   @db.Text
  isShared  Boolean  @default(false)
  // When true (default), draft generation skips the Claude rewrite pass
  // for this template — only merge-tag substitution runs, including the
  // AI-derived {{feature_line}} / {{fit_angle}}. Lets template authors
  // write the exact wording and have the AI plug in only the parts that
  // depend on per-recipient research. Set to false on a template-by-
  // template basis to fall back to the rewrite path.
  verbatim      Boolean  @default(true)
  attachmentIds Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns Campaign[]

  @@index([userId])
  @@schema("public")
}

model Campaign {
  id                     String         @id @default(cuid())
  userId                 String
  name                   String
  subject                String?
  status                 CampaignStatus @default(DRAFT)
  templateId             String?
  template               Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt            DateTime?
  filterIndustry         String?
  filterRegion           String[]
  filterStage            String[]
  filterBatch            String[]
  filterIsHiring         Boolean?
  filterTags             String[]
  // Per-campaign override of user.workspace_config.targetRole. One of the
  // RoleFamily ids (see src/types/roleFamilies.ts) — "engineering",
  // "product", "gtm", "operations" — or null to inherit the user default.
  // Resolved at Apollo searchContacts time, not at company-pool query time.
  filterTargetRole       String?
  batchSize              Int            @default(10)
  currentBatch           Int            @default(0)
  tone                   String?
  attachmentIds          Json           @default("[]")
  // When false (default), batch generation excludes companies the user has
  // already saved in any other campaign. Toggle exposed in the create wizard
  // (Step 2) and the campaign settings sub-tab. Enforcement lives in
  // server/lib/company-selection.ts.
  includePreviouslySaved Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  seenCompanies  CampaignSeenCompany[]
  leads          CampaignLead[]
  customContacts CampaignCustomContact[]

  @@index([userId])
  @@index([templateId])
  @@schema("public")
}

model CampaignSeenCompany {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  seenAt     DateTime @default(now())

  @@unique([campaignId, companyId])
  @@index([campaignId])
  @@index([companyId])
  @@schema("public")
}

model DiscoverySeenCompany {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  seenAt    DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@schema("public")
}

model CampaignLead {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userLeadId  String
  userLead    UserLead @relation(fields: [userLeadId], references: [id], onDelete: Cascade)
  batchNumber Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([campaignId, batchNumber, userLeadId])
  @@index([campaignId])
  @@index([userLeadId])
  @@index([campaignId, userLeadId])
  @@schema("public")
}

model CampaignCustomContact {
  id              String        @id @default(cuid())
  campaignId      String
  campaign        Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customContactId String
  customContact   CustomContact @relation(fields: [customContactId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([campaignId, customContactId])
  @@index([campaignId])
  @@index([customContactId])
  @@schema("public")
}

model DailyQuota {
  scope     String
  subjectId String
  action    String
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([scope, subjectId, action, day])
  @@schema("public")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED

  @@schema("public")
}

// Single-row precomputed snapshot of /api/campaign-options.
// Refreshed manually via scripts/refresh-company-options.ts after ingest
// sessions complete. The endpoint reads this table directly instead of
// firing 10 parallel aggregations on every Leads-tab mount — see the
// 2026-05-22 incident retro in the commit log for the motivation.
// Always exactly one row (id = "singleton"). If the row is missing
// (e.g., immediately after deploy on a fresh DB), the endpoint falls
// back to live compute + writes the row.
model CompanyOptionsSnapshot {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt

  @@schema("public")
}

/// Managed by Supabase Auth via supabase/schema.sql — not tracked by Prisma migrations.
model UserProfile {
  userId                      String    @id @map("user_id") @db.Uuid
  googleRefreshTokenEncrypted String?   @map("google_refresh_token_encrypted")
  resumePath                  String?   @map("resume_path")
  resumeText                  String?   @map("resume_text")
  workspaceConfig             Json      @default("{}") @map("workspace_config")
  defaultFilters              Json      @default("{}") @map("default_filters")
  fullName                    String?   @map("full_name")
  bio                         String?
  targetRole                  String?   @map("target_role")
  onboardingCompleted         Boolean   @default(false) @map("onboarding_completed")
  onboardingCompletedAt       DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt                   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@ignore
  @@map("user_profiles")
  @@schema("public")
}
