generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Company {
  id            String    @id @default(cuid())
  name          String
  domain        String    @unique
  description   String?   @db.Text
  oneLiner      String?
  website       String?
  stage         String?
  industry      String?
  subIndustry   String?
  location      String?
  region        String?
  headcount     Int?
  isHiring      Boolean   @default(false)
  batch         String?
  source        String
  sourceId      String?
  tags          String[]  @default([])
  isVerified    Boolean   @default(true)
  qualityScore  Int?
  lastScrapedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contacts     Contact[]
  userLeads    UserLead[]
  campaignSeen CampaignSeenCompany[]

  @@index([stage])
  @@index([industry])
  @@index([region])
  @@index([isHiring])
  @@index([source])
  @@index([headcount])
  @@index([isVerified])
  @@index([qualityScore])
  @@index([tags], type: Gin)
  @@schema("public")
}

model Contact {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String?
  email          String?   @unique
  title          String?
  role           String?
  linkedinUrl    String?
  source         String
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userLeads UserLead[]
  emails    Email[]

  @@index([companyId])
  @@index([role])
  @@index([lastVerifiedAt])
  @@schema("public")
}

model UserLead {
  id             String     @id @default(cuid())
  userId         String
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  contactId      String?
  contact        Contact?   @relation(fields: [contactId], references: [id])
  apolloPersonId String?
  status         LeadStatus @default(NEW)
  notes          String?    @db.Text
  addedAt        DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  emails        Email[]
  campaignLeads CampaignLead[]

  @@unique([userId, companyId, contactId])
  @@index([userId])
  @@index([status])
  @@schema("public")
}

enum LeadStatus {
  NEW
  SAVED
  EMAILED
  NO_RESPONSE
  DECLINED

  @@schema("public")
}

model CustomContact {
  id          String   @id @default(cuid())
  userId      String
  name        String?
  email       String?
  title       String?
  companyName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emails Email[]

  @@index([userId])
  @@schema("public")
}

model Email {
  id              String         @id @default(cuid())
  userLeadId      String?
  userLead        UserLead?      @relation(fields: [userLeadId], references: [id])
  contactId       String?
  contact         Contact?       @relation(fields: [contactId], references: [id])
  customContactId String?
  customContact   CustomContact? @relation(fields: [customContactId], references: [id])
  subject         String?
  body            String?        @db.Text
  status          String         @default("draft")
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userLeadId])
  @@index([contactId])
  @@index([customContactId])
  @@schema("public")
}

model Template {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String
  body      String   @db.Text
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([userId])
  @@schema("public")
}

model Campaign {
  id                 String         @id @default(cuid())
  userId             String
  name               String
  subject            String?
  status             CampaignStatus @default(DRAFT)
  templateId         String?
  template           Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt        DateTime?
  filterIndustry     String?
  filterRegion       String?
  filterStage        String?
  filterBatch        String?
  filterIsHiring     Boolean?
  filterHeadcountMin Int?
  filterHeadcountMax Int?
  filterTags         String[]
  batchSize          Int            @default(10)
  currentBatch       Int            @default(0)
  tone               String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  seenCompanies CampaignSeenCompany[]
  leads         CampaignLead[]

  @@index([userId])
  @@index([status])
  @@index([templateId])
  @@schema("public")
}

model CampaignSeenCompany {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  seenAt     DateTime @default(now())

  @@unique([campaignId, companyId])
  @@index([campaignId])
  @@schema("public")
}

model CampaignLead {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userLeadId  String
  userLead    UserLead @relation(fields: [userLeadId], references: [id], onDelete: Cascade)
  batchNumber Int      @default(1)
  createdAt   DateTime @default(now())

  @@unique([campaignId, batchNumber, userLeadId])
  @@index([campaignId])
  @@index([campaignId, batchNumber])
  @@schema("public")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED

  @@schema("public")
}
